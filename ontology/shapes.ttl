@prefix c: <urn:contexton:vocab:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
c:AttributionShape a sh:NodeShape ;
 sh:targetClass c:ImageNode, c:RelationInterpretation, c:Opinion, c:OpinionReaction, c:Draft, c:AIWritingResult ;
 sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Agent ] ;
 sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .
c:NodeShape a sh:NodeShape ; sh:targetClass c:ImageNode ;
 sh:property [ sh:path c:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 80 ] ;
 sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 200 ] ;
 sh:or ( [ sh:property [ sh:path rdf:value ; sh:minLength 1 ] ] [ sh:property [ sh:path c:image ; sh:minCount 1 ; sh:minLength 1 ] ] ) .
c:LinkShape a sh:NodeShape ; sh:targetClass c:Link ;
 sh:property [ sh:path c:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:ImageNode ; sh:disjoint c:target ] ;
 sh:property [ sh:path c:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:ImageNode ] .
c:InterpretationShape a sh:NodeShape ; sh:targetClass c:RelationInterpretation ;
 sh:property [ sh:path c:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:Link ] ;
 sh:property [ sh:path c:relationType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ] ;
 sh:property [ sh:path c:definition ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] ;
 sh:property [ sh:path c:family ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("logic" "perspective") ] .
c:OpinionShape a sh:NodeShape ; sh:targetClass c:Opinion ;
 sh:property [ sh:path c:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:RelationInterpretation ] ;
 sh:property [ sh:path c:stance ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (c:support c:not-support c:undecided) ] ;
 sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] .
c:ParagraphShape a sh:NodeShape ; sh:targetClass c:Paragraph ;
 sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:property [ sh:path c:origin ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("network" "creative" "verify") ] ;
 sh:property [ sh:path prov:wasDerivedFrom ; sh:class prov:Entity ] .
c:DraftShape a sh:NodeShape ; sh:targetClass c:Draft ;
 sh:property [ sh:path c:snapshot ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:SourceSnapshot ] ;
 sh:property [ sh:path c:paragraphs ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ] .

c:ReactionShape a sh:NodeShape ; sh:targetClass c:OpinionReaction ;
 sh:property [ sh:path c:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:Opinion ] ;
 sh:property [ sh:path c:reaction ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "agree" "veto" ) ] .

# A displayed family must agree with the selected SKOS concept's scheme.
c:InterpretationFamilyShape a sh:NodeShape ; sh:targetClass c:RelationInterpretation ;
 sh:or (
 [ sh:property [ sh:path c:family ; sh:hasValue "logic" ] ; sh:property [ sh:path c:relationType ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue c:logic ] ] ] ]
 [ sh:property [ sh:path c:family ; sh:hasValue "perspective" ] ; sh:property [ sh:path c:relationType ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue c:perspective ] ] ] ]
 ) .
c:WritingGuideShape a sh:NodeShape ; sh:targetClass c:WritingGuide ;
 sh:property [ sh:path c:materialSnapshot ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:SourceSnapshot ] ;
 sh:property [ sh:path c:settings ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:JSON ] ;
 sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .
c:SourceMaterialShape a sh:NodeShape ; sh:targetClass c:SourceMaterial ;
 sh:property [ sh:path c:payload ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:JSON ] ;
 sh:property [ sh:path c:capturedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
 sh:property [ sh:path c:materialRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("node" "link" "interpretation") ] .
c:GenerationInputShape a sh:NodeShape ; sh:targetClass c:GenerationInput ;
 sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:property [ sh:path c:guide ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ([ sh:class c:WritingGuide ] [ sh:class c:HistoricalGuideReference ]) ] .
c:GenerationShape a sh:NodeShape ; sh:targetClass c:AIGeneration ;
 sh:property [ sh:path prov:used ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:GenerationInput ] ;
 sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ] ;
 sh:property [ sh:path prov:endedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .
c:AIWritingResultShape a sh:NodeShape ; sh:targetClass c:AIWritingResult ;
 sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:AIGeneration ] ;
 sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:class c:GenerationInput ] ;
 sh:property [ sh:path c:partial ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
